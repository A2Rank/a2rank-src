<Window x:Class="Aion2Meter.App.LiveCombatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="실시간 전투" MinWidth="300" MinHeight="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Malgun Gothic" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <!-- One opponent: rank, name (server, class), what I did and what I took, with a bar each (relative to the biggest line) -->
        <DataTemplate x:Key="RowTemplate">
            <Border Background="#0DFFFFFF" CornerRadius="6" Margin="0,1.5" Padding="8,4,8,5">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Caption}" FontSize="10" Width="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Caption}" FontSize="9.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Dealt}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding Received}" Foreground="{StaticResource LossBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                    <Border Height="3" CornerRadius="1.5" Margin="18,3,0,0" Background="{Binding DealtBar}" />
                    <Border Height="3" CornerRadius="1.5" Margin="18,2,0,0" Background="{Binding ReceivedBar}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- The sort choices in the header: plain words, the chosen one lit -->
        <Style x:Key="SortWord" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource KillListPanelBrush}" BorderBrush="{StaticResource PanelEdgeBrush}" BorderThickness="1"
            CornerRadius="12" Padding="10,8,10,14"
            PreviewMouseLeftButtonDown="OnPress" PreviewMouseMove="OnMove" PreviewMouseLeftButtonUp="OnRelease">
        <DockPanel>
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,0">
                <Button DockPanel.Dock="Right" x:Name="ResetButton" Content="&#xE72C;" Style="{StaticResource IconButton}" Click="OnReset"
                        ToolTip="목록 비우기 (지금까지의 실시간 합계를 지우고 새로 시작; 처치·사망 기록에는 영향 없음)" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SortTotal" Text="합계" Style="{StaticResource SortWord}" ToolTip="준 피해와 받은 피해의 합이 큰 순" Tag="0" />
                    <TextBlock x:Name="SortDealt" Text="준 피해" Style="{StaticResource SortWord}" ToolTip="내가 준 피해가 큰 순" Tag="1" />
                    <TextBlock x:Name="SortReceived" Text="받은 피해" Style="{StaticResource SortWord}" ToolTip="내가 받은 피해가 큰 순" Tag="2" />
                </StackPanel>
                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock Text="실시간 전투" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Totals over everyone on the board -->
            <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="-3,8,-3,0">
                <Border Background="{StaticResource TileBrush}" CornerRadius="6" Padding="7,3" Margin="3">
                    <StackPanel>
                        <TextBlock Text="상대" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="OpponentCount" FontSize="11.5" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource TileBrush}" CornerRadius="6" Padding="7,3" Margin="3">
                    <StackPanel>
                        <TextBlock Text="준 피해" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="TotalDealt" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource TileBrush}" CornerRadius="6" Padding="7,3" Margin="3">
                    <StackPanel>
                        <TextBlock Text="받은 피해" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="TotalReceived" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource LossBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock x:Name="Empty" DockPanel.Dock="Top" Text="지금 싸우는 상대가 없습니다 (다른 플레이어와 주고받은 피해만 보여 줍니다)." Style="{StaticResource Caption}"
                       FontSize="10.5" TextWrapping="Wrap" Margin="2,10,2,0" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                <StackPanel>
                    <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource RowTemplate}" />
                    <TextBlock x:Name="More" Style="{StaticResource Caption}" FontSize="10" Margin="4,4,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
