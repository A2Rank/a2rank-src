<Window x:Class="Aion2Meter.App.CharacterInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="캐릭터 정보" Width="1000" Height="820" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic" FontSize="12.5"
        Background="{StaticResource PanelBaseBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="14,10,14,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="DetailsButton" Content="마석·영혼 각인 불러오기 (약 19번 조회)" Click="OnLoadDetails" Padding="10,3" Margin="0,0,6,0" IsEnabled="False" />
                <Button x:Name="RefreshButton" Content="새로 고침" Click="OnRefresh" Padding="10,3" Margin="0,0,6,0" IsEnabled="False" />
                <Button x:Name="BrowserButton" Content="공식 사이트에서 보기" Click="OnOpenInBrowser" Padding="10,3" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="14,4,14,8" FontSize="10.5" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap"
                   Text="게임사 공식 캐릭터 정보실(aion2.plaync.com)의 공개 정보입니다. 이름을 누른 때에만 그 사이트로 조회합니다: 처음에는 3번(찾기, 프로필, 장비 목록)이고, 마석과 영혼 각인은 위의 버튼을 눌렀을 때만 약 19번의 작은 요청으로 읽어 옵니다. 읽은 내용은 저장하지 않습니다, 값은 게임 안과 다를 수 있습니다." />
        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Margin="14,4,14,4" />
        </ScrollViewer>
    </DockPanel>
</Window>
