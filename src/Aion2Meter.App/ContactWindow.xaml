<Window x:Class="Aion2Meter.App.ContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="문의하기" Width="460" Height="590" MinWidth="380" MinHeight="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" FontFamily="Malgun Gothic" FontSize="12.5"
        Foreground="{StaticResource TextBrush}" AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKey">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TileBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FF0F141A" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBaseBrush}" BorderBrush="{StaticResource PanelEdgeBrush}" BorderThickness="1" CornerRadius="12">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="16,12,12,6" Background="Transparent" MouseLeftButtonDown="OnTitleDrag">
                <Button DockPanel.Dock="Right" Content="닫기" Click="OnClose" Padding="10,3" />
                <TextBlock Text="&#xE715;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="문의하기" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="16,4,16,14">
                <TextBlock x:Name="StatusText" Style="{StaticResource Note}" Margin="0,0,0,6" />
                <DockPanel>
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Content="보내기" Click="OnSend" MinWidth="90" Style="{StaticResource AccentButton}" />
                    <TextBlock x:Name="CountText" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0" />
                </DockPanel>
            </StackPanel>

            <StackPanel Margin="16,2,16,4">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="내용" Style="{StaticResource Section}" />
                        <TextBox x:Name="MessageBox" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto" TextChanged="OnTextChanged" />
                        <TextBlock Style="{StaticResource Note}" Text="오류, 제안, 보낸 데이터의 삭제 요청(보낸 시각을 적어 주세요)을 적어 주세요." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="답장 받을 곳 (선택)" Style="{StaticResource Section}" />
                        <TextBox x:Name="ReplyBox" MaxLength="100" />
                        <TextBlock Style="{StaticResource Note}" Text="이메일이나 디스코드 이름을 적으면 답장할 수 있습니다. 비워 두면 답장은 받을 수 없습니다." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="이미지 (선택, 3장까지)" Style="{StaticResource Section}" />
                        <StackPanel x:Name="ImageRows" />
                        <Button x:Name="AddImageButton" Content="이미지 추가…" Click="OnAddImages" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Note}" Text="창에 끌어다 놓거나 Ctrl+V로 붙여넣을 수도 있습니다. png, jpg, webp, 한 장에 4MB까지. 게임 화면의 캐릭터 이름 등이 보이면 가려서 보내 주세요." />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Note}">
                    보내는 것은 위 두 칸과 앱 버전뿐입니다. 비밀번호 같은 개인정보는 적지 마세요.
                    <Hyperlink NavigateUri="https://github.com/A2Rank/releases/blob/main/PRIVACY.md" RequestNavigate="OnLink">개인정보 처리방침</Hyperlink>
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
