<Window x:Class="Aion2Meter.App.KillDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="처치 자세히" Width="720" Height="520" MinWidth="560" MinHeight="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        Topmost="True" ShowInTaskbar="False"
        FontFamily="Malgun Gothic" FontSize="12" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style x:Key="HeadCell" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- One skill as a card: name and total damage with its share, a share bar, how its hits landed (share of the skill's hits), uses and sizes -->
        <DataTemplate x:Key="SkillLineTemplate">
            <Border Background="#0DFFFFFF" CornerRadius="6" Padding="9,5,9,6" Margin="0,0,0,5">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,170,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Total}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding Share}" FontSize="11.5" Margin="8,0,0,0" MinWidth="40" TextAlignment="Right" />
                        </StackPanel>
                    </Grid>
                    <Border Height="3" CornerRadius="1.5" Margin="0,3,0,4" Background="{Binding Bar}" />
                    <ItemsControl ItemsSource="{Binding Chips}" Visibility="{Binding ChipsVisibility}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,11,1">
                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource FaintBrush}" />
                                    <TextBlock Text="{Binding Value}" FontSize="10.5" FontWeight="SemiBold" Margin="3,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Usage}" Style="{StaticResource Caption}" FontSize="10" Margin="0,1,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One attacker before a death: name and amount, their top skills below -->
        <!-- An expander without the system look: the header is the whole line, a small arrow shows whether it is open -->
        <Style x:Key="AttackerExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" Cursor="Hand" Foreground="{StaticResource TextBrush}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,2">
                                            <DockPanel>
                                                <TextBlock x:Name="Arrow" DockPanel.Dock="Left" Text="&#x25B8;" Width="14" FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                                <ContentPresenter />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text" Value="&#x25BE;" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" />
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="14,2,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AttackerLineTemplate">
            <Expander Style="{StaticResource AttackerExpander}" IsExpanded="{Binding Expanded, Mode=OneTime}" IsEnabled="{Binding CanExpand}" Margin="0,1.5,0,4">
                <Expander.Header>
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,110,0" />
                            <TextBlock Text="{Binding Amount}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap" Visibility="{Binding DetailVisibility}" />
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Skills}" ItemTemplate="{StaticResource SkillLineTemplate}" />
            </Expander>
        </DataTemplate>

        <!-- Left list of the single kills: plain lines, the chosen one lit -->
        <Style x:Key="EntryItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Box" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource TileBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBaseBrush}" BorderBrush="{StaticResource PanelEdgeBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8,12,12">
        <DockPanel>
            <!-- Title bar: drag to move -->
            <DockPanel DockPanel.Dock="Top" Background="Transparent" MouseLeftButtonDown="OnTitleDown" MouseMove="OnTitleMove" MouseLeftButtonUp="OnTitleUp">
                <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource IconButton}" Click="OnClose" ToolTip="닫기" />
                <TextBlock x:Name="Title" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock x:Name="Subtitle" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,2,0,0" />

            <!-- Totals -->
            <UniformGrid x:Name="Tiles" DockPanel.Dock="Top" Columns="4" Margin="-3,8,-3,4">
                <Border Background="{StaticResource TileBrush}" CornerRadius="6" Padding="8,4" Margin="3">
                    <StackPanel>
                        <TextBlock x:Name="TileOneLabel" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="TileOne" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource TileBrush}" CornerRadius="6" Padding="8,4" Margin="3">
                    <StackPanel>
                        <TextBlock Text="준 피해" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="TileDealt" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource TileBrush}" CornerRadius="6" Padding="8,4" Margin="3">
                    <StackPanel>
                        <TextBlock Text="받은 피해" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="TileReceived" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource LossBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource TileBrush}" CornerRadius="6" Padding="8,4" Margin="3">
                    <StackPanel>
                        <TextBlock Text="받은 회복" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="TileHealed" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource GainBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Whole / each kill -->
                <ListBox x:Name="Entries" Background="Transparent" BorderThickness="0" Margin="0,0,10,0" ItemContainerStyle="{StaticResource EntryItem}"
                         SelectionChanged="OnSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11.5" />
                                    <TextBlock Text="{Binding Points}" Foreground="{Binding PointsColor}" FontSize="11" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding Sub}" Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- The chosen one in detail -->
                <ScrollViewer x:Name="DetailScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Detail" Margin="0,0,6,0">
                        <TextBlock x:Name="NoDamage" Text="이 기록에는 피해 정보가 없습니다 (이름 확인 전이거나 전투를 보지 못한 경우)."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="DealtHeader" Text="준 피해 (내 스킬별)" Style="{StaticResource SectionLabel}" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="DealtHow" Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3" />
                        <ItemsControl x:Name="DealtLines" ItemTemplate="{StaticResource SkillLineTemplate}" />
                        <TextBlock x:Name="ReceivedHeader" Text="받은 피해 (상대 스킬별)" Style="{StaticResource SectionLabel}" Foreground="{StaticResource LossBrush}" />
                        <TextBlock x:Name="ReceivedHow" Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3" />
                        <ItemsControl x:Name="ReceivedLines" ItemTemplate="{StaticResource SkillLineTemplate}" />
                        <TextBlock x:Name="HealedHeader" Text="받은 회복 (스킬별)" Style="{StaticResource SectionLabel}" Foreground="{StaticResource GainBrush}" />
                        <ItemsControl x:Name="HealedLines" ItemTemplate="{StaticResource SkillLineTemplate}" />
                        <TextBlock x:Name="AttackerHeader" Text="사망 직전 30초 동안 받은 피해 (공격자별, 눌러서 펼치기)" Style="{StaticResource SectionLabel}" Foreground="{StaticResource LossBrush}" />
                        <ItemsControl x:Name="AttackerLines" ItemTemplate="{StaticResource AttackerLineTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
