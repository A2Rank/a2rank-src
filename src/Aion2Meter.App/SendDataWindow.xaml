<Window x:Class="Aion2Meter.App.SendDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="데이터 보내기" Width="520" Height="640" MinWidth="420" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" FontFamily="Malgun Gothic" FontSize="12.5"
        Foreground="{StaticResource TextBrush}" AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKey">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TileBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FF0F141A" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                                    BorderBrush="{StaticResource FaintBrush}" Background="Transparent" VerticalAlignment="Center">
                                <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Foreground="#FF0F141A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBaseBrush}" BorderBrush="{StaticResource PanelEdgeBrush}" BorderThickness="1" CornerRadius="12">
        <DockPanel>
            <!-- Title bar -->
            <DockPanel DockPanel.Dock="Top" Margin="16,12,12,6" Background="Transparent" MouseLeftButtonDown="OnTitleDrag">
                <Button DockPanel.Dock="Right" Content="닫기" Click="OnClose" Padding="10,3" />
                <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="데이터 보내기" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Send -->
            <StackPanel DockPanel.Dock="Bottom" Margin="16,4,16,14">
                <TextBlock x:Name="StatusText" Style="{StaticResource Note}" Margin="0,0,0,6" />
                <DockPanel>
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Content="보내기" Click="OnSend" MinWidth="90"
                            Style="{StaticResource AccentButton}" />
                    <TextBlock x:Name="SizeText" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0" />
                </DockPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,2,8,4" Padding="0,0,8,0">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FaintBrush}" FontSize="11.5" Margin="0,0,0,10"
                               Text="받은 패킷과 인게임 전투 분석기 캡처를 맞춰 보고, 아직 이름을 모르는 스킬을 알아내는 데 씁니다. 보내 주신 만큼 스킬 이름이 정확해집니다." />

                    <!-- 1. Consent -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="1. 인게임 패킷 수집" Style="{StaticResource Section}" />
                            <CheckBox x:Name="Consent" Content="인게임 패킷 수집에 동의합니다" Click="OnConsent" />
                            <TextBlock Style="{StaticResource Note}"
                                       Text="동의하면 다음 측정을 시작할 때부터, 전투가 시작되면 그 순간의 1분 전부터 마지막 전투 5분 뒤까지의 패킷이 전투마다 파일 하나로 이 PC에 저장됩니다(전투가 없으면 저장하지 않고, 자동으로 보내지지 않습니다). 패킷에는 캐릭터 이름과 전투 내용이 들어 있습니다. 비밀번호와 결제 정보는 이 게임의 패킷에 들어 있지 않습니다. 보내기를 누르면 최근 1시간의 녹화(없으면 최근 3개)가 캡처와 함께 올라가며, 어떤 파일이 올라가는지는 아래에 보여 드립니다. 이 PC의 녹화는 합쳐서 300 MB까지만 보관하고, 넘으면 오래된 것부터 자동으로 지웁니다. 동의를 끄면 수집을 멈춥니다." />
                            <TextBlock x:Name="ConsentState" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Style="{StaticResource Note}"><Hyperlink NavigateUri="https://github.com/A2Rank/releases/blob/main/PRIVACY.md" RequestNavigate="OnLink">개인정보 처리방침</Hyperlink> (보내는 정보, 보관 기간, 삭제 요청 방법)</TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 2. Recordings -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="2. 함께 보낼 패킷 녹화 (자동)" Style="{StaticResource Section}" />
                            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,4"
                                       Text="고르실 필요 없습니다. 보내기를 누르면 최근 1시간의 녹화(방금 전투까지, 없으면 최근 3개)가 자동으로 함께 올라가고, 캡처와 어느 녹화가 맞는지는 저희가 찾습니다." />
                            <TextBlock x:Name="RecordingsEmpty" Style="{StaticResource Note}" Margin="0"
                                       Text="아직 녹화가 없습니다. 동의한 뒤 측정을 시작하고 전투한 다음 다시 열어 주세요 (전투가 시작되면 녹화가 만들어집니다)." />
                            <StackPanel x:Name="RecordingRows" />
                        </StackPanel>
                    </Border>

                    <!-- 3. Screenshots -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="3. 인게임 전투 분석기 캡처" Style="{StaticResource Section}" />
                            <Border Background="#1AFFFFFF" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="캡처 방법 (꼭 확인해 주세요)" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,3,0,0" LineHeight="17"
                                               Text="측정을 켠 채로 허수아비를 치고, 전투 분석기의 스킬별 표(스킬 이름, 타격 수, 총 피해량)를 캡처해 주세요. 표의 숫자와 패킷을 맞춰 스킬 이름을 확정합니다." />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource FaintBrush}"
                                               Text="· 허수아비를 한 번만 치고(30초~1분), 그 한 번의 전투가 분석기에 담긴 상태에서 캡처해 주세요. 쓸 수 있는 스킬을 가능한 한 많이 한 번 이상씩 써 주세요.&#10;· 표의 모든 행이 보이게 캡처해 주세요. 한 장에 다 안 들어가면 위아래로 이어서 여러 장 찍어 주세요.&#10;· 패킷 녹화와 같은 시간대의 전투여야 합니다. 전투가 끝나고 캡처할 때까지 측정을 멈추지 말아 주세요." />
                                    <Button x:Name="ExampleButton" Content="예시 사진 보기" Click="OnExample" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,3" />
                                    <StackPanel x:Name="ExamplePanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Image Source="help-analyzer.png" Width="400" HorizontalAlignment="Left" Stretch="Uniform" />
                                        <TextBlock Style="{StaticResource Note}"
                                                   Text="이런 스킬별 표입니다: 스킬 이름, 타격 수(HIT), 총 피해량이 보이면 됩니다. 스킬 이름을 맞추는 분석에만 쓰고, 분석은 AI가 합니다." />
                                        <TextBlock Text="전투 로그 (채팅창)" FontWeight="SemiBold" FontSize="11.5" Margin="0,12,0,4" />
                                        <Image Source="help-combatlog.png" Width="300" HorizontalAlignment="Left" Stretch="Uniform" />
                                        <TextBlock Style="{StaticResource Note}"
                                                   Text="회복이나 효과 이름이 궁금한 스킬은 이런 전투 로그도 좋습니다. 시각(00:36)과 스킬 이름, 숫자가 보이게 캡처해 주세요. 캐릭터 이름이 보여도 괜찮습니다 (분석은 AI가 합니다)." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="붙여넣기 (Ctrl+V)" Click="OnPaste" Style="{StaticResource AccentButton}" />
                                <Button Content="이미지 추가…" Click="OnAddImages" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Note}"
                                       Text="캡처한 뒤 이 창에서 Ctrl+V를 누르면 바로 추가됩니다 (Win+Shift+S 캡처 등). 이미지 파일을 끌어다 놓아도 됩니다." />
                            <StackPanel x:Name="ImageRows" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Note -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="메모 (선택)" Style="{StaticResource Section}" />
                            <TextBox x:Name="NoteBox" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="90"
                                     Background="#1AFFFFFF" Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="6,4"
                                     CaretBrush="{StaticResource TextBrush}" />
                            <TextBlock Style="{StaticResource Note}" Text="어떤 직업·무슨 상황이었는지 적어 주시면 도움이 됩니다." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
